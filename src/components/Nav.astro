---
import Logo from './Logo.astro';
import { ETAPES } from '../lib/nav';
import ProjectSwitcher from '../islands/ProjectSwitcher';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header id="nav" class="nav">
  <div class="container nav-inner">
    <a href="/" aria-label="Gemula Learn, accueil"><Logo /></a>
    <nav class="nav-links" aria-label="Étapes du parcours">
      {ETAPES.map((e, i) => (
        <a href={e.href} aria-current={path === e.href ? 'page' : undefined}><span class="n">{i + 1}</span>{e.court}</a>
      ))}
    </nav>
    <div class="nav-right">
      <ProjectSwitcher client:only="preact" />
      <button id="burger" class="btn btn-ghost btn-icon burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-panel">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-panel" class="mobile-panel hidden">
    <nav class="container" aria-label="Navigation mobile">
      {ETAPES.map((e, i) => (
        <a href={e.href} aria-current={path === e.href ? 'page' : undefined}><span class="n">{i + 1}</span>{e.titre}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  .nav { position: fixed; inset: 0 0 auto; z-index: 50; border-bottom: 1px solid transparent; transition: background-color .2s, border-color .2s; }
  .nav[data-scrolled='true'] { border-color: var(--line); background: rgba(8, 9, 10, 0.78); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
  .nav-inner { display: flex; height: 64px; align-items: center; justify-content: space-between; gap: 16px; }
  .nav-links { display: none; align-items: center; gap: 2px; }
  .nav-links a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 10px; border-radius: 8px; font-size: 0.875rem; color: var(--muted); transition: color .15s; }
  .nav-links a:hover, .nav-links a[aria-current='page'] { color: var(--fg); }
  .nav-links a[aria-current='page'] { background: var(--surface-2); }
  .n { font-size: 0.6875rem; font-weight: 600; color: var(--accent-text); font-variant-numeric: tabular-nums; }
  .nav-right { display: flex; align-items: center; gap: 8px; }
  .mobile-panel { border-top: 1px solid var(--line); background: rgba(8, 9, 10, 0.96); backdrop-filter: blur(20px); }
  .mobile-panel nav { display: flex; flex-direction: column; padding-top: 8px; padding-bottom: 12px; }
  .mobile-panel a { display: flex; align-items: center; gap: 10px; min-height: 48px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .mobile-panel a[aria-current='page'] { color: var(--fg); }
  @media (min-width: 1080px) { .nav-links { display: flex; } .burger { display: none; } }
</style>
<script>
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.setAttribute('data-scrolled', String(window.scrollY > 8));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const burger = document.getElementById('burger');
  const panel = document.getElementById('mobile-panel');
  burger?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    burger.setAttribute('aria-expanded', String(open));
    if (open) nav?.setAttribute('data-scrolled', 'true');
  });
</script>
