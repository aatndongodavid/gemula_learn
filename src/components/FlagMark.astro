---
// Drapeau Gemula (damier qui ondule), repris du site gemula.org.
import { flagCells, FLAG_VIEWBOX } from '../lib/flag';
interface Props { class?: string; color?: string; }
const { class: className = '', color = '#FF5000' } = Astro.props;
const cells = flagCells();
---
<svg class={`flag ${className}`} viewBox={FLAG_VIEWBOX} fill={color} aria-hidden="true" focusable="false">
  {cells.map((d) => <path d={d} />)}
</svg>
